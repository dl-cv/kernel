# Hardware cut config fragment for tspi-3m-rk3576 Debian desktop.

# Enable only the IMX334 sensor used on the CSI0/I2C4 camera link.
# CONFIG_VIDEO_IMX296 is not set
CONFIG_VIDEO_IMX334=y

# HDMI_TX connector and related circuits are removed.
# CONFIG_RK628_MISC_HDMITX is not set
# CONFIG_ROCKCHIP_DW_HDMI is not set
# CONFIG_ROCKCHIP_INNO_HDMI is not set
# CONFIG_DRM_DW_HDMI_I2S_AUDIO is not set
# CONFIG_DRM_DW_HDMI_CEC is not set
# CONFIG_PHY_ROCKCHIP_INNO_HDMI is not set
# CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX_HDMI is not set

# MIPI DSI connector, SY7201ABC backlight/power circuits are removed.
# CONFIG_ROCKCHIP_DW_MIPI_DSI is not set
# CONFIG_ROCKCHIP_DW_MIPI_DSI2 is not set
# CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY is not set
# CONFIG_MFD_RKX110_X120 is not set
# CONFIG_PWM_RKX120 is not set
# CONFIG_ROCKCHIP_SERDES_DRM_PANEL is not set

# MINI-PCIe slot and related SATA/PCIe/4G mode circuits are removed.
# CONFIG_PCIE_ROCKCHIP_HOST is not set
# CONFIG_PCIE_DW_ROCKCHIP is not set
# CONFIG_AHCI_DWC is not set

# ES8388 codec, onboard MIC, headphone jack, headset detect/button circuits are removed.
# CONFIG_SND_SOC_ROCKCHIP_SAI is not set
# CONFIG_SND_SOC_ROCKCHIP_MULTICODECS is not set
# CONFIG_SND_SOC_ES8323 is not set
# CONFIG_SND_SOC_ES8328_I2C is not set
# CONFIG_RK_HEADSET is not set

# DP audio (spdif_tx3 -> dp0) is also removed.
# CONFIG_SND_SOC_ROCKCHIP_SPDIF is not set
# CONFIG_SND_SOC_ROCKCHIP_SPDIFRX is not set
# CONFIG_SND_SOC_SPDIF is not set
# CONFIG_SND_SOC_ROCKCHIP_HDMI is not set
# CONFIG_SND_SIMPLE_CARD is not set
# CONFIG_SND_USB_AUDIO is not set

# TF card slot and SDMMC0 related circuits are removed; eMMC SDHCI remains enabled.
# CONFIG_MMC_DW_ROCKCHIP is not set

# Only CSI0 (IMX334) is retained; CSI1/CSI3 sensors are removed.
# CONFIG_VIDEO_IMX415 is not set
