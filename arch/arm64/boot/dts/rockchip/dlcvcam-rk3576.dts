/*-----------------------------------------------------------
 * Uncomment the required dtsi based on the compiled system type
 *----------------------------------------------------------*/
// #include "rk3576-android.dtsi"
#include "rk3576-linux.dtsi"

/*-----------------------------------------------------------
 * Core layer configuration, almost no need to modify here, contains basic configurations
 *----------------------------------------------------------*/
#include "dlcvcam-rk3576-core.dtsi"

/* TF card slot and related power/detect circuits are removed. */
&vcc_3v3_sdcard {
	status = "disabled";
};

&sdmmc {
	status = "disabled";
};

/*-----------------------------------------------------------
 * Type-C-OTG Configuration
 *----------------------------------------------------------*/
#include "dlcvcam-rk3576-typec.dtsi"

/*-----------------------------------------------------------
 * USB-HOST Configuration
 * Hardware cut: FE2.1 USB hub and three standalone USB2.0 ports are removed.
 * Keep USB3_OTG1 host; USB2_HOST1 is wired directly to the USB3.0 connector.
 *----------------------------------------------------------*/
#include "dlcvcam-rk3576-usb-host.dtsi"

/*-----------------------------------------------------------
 * Ethernet Port Configuration
 *----------------------------------------------------------*/
#include "dlcvcam-rk3576-eth.dtsi"

/*-----------------------------------------------------------
 * WIFI-BT Module Configuration, default is AP6256 module
 * Special Note: Module requires RTC 32KHz clock support, please ensure RTC is started
 * Hardware cut: AP6256 and TXB0104RUTR are removed, keep WiFi/BT disabled.
 *----------------------------------------------------------*/
// #include "dlcvcam-rk3576-sdio-wifibt.dtsi"

/*-----------------------------------------------------------
 * HYM8563 RTC Configuration
 *----------------------------------------------------------*/
#include "dlcvcam-rk3576-rtc.dtsi"

/*-----------------------------------------------------------
 * CSI-MIPI Camera Configuration
 *
 * TaishanPi 3M RK3576 CSI-MIPI 4Lanes x 3 Camera Link Description:
 *
 * [sensor0] -> [csi2_dcphy0]->[mipi0_csi2]->[rkcif_mipi_lvds]->[rkcif_mipi_lvds_sditf]->[rkisp_vir0]
 * [sensor1] -> [csi2_dphy0]->[mipi1_csi2]->[rkcif_mipi_lvds1]->[rkcif_mipi_lvds1_sditf]->[rkisp_vir1]
 * [sensor2] -> [csi2_dphy3]->[mipi3_csi2]->[rkcif_mipi_lvds3]->[rkcif_mipi_lvds3_sditf]->[rkisp_vir2]
 *
 * Uncomment or comment the corresponding dtsi file according to the required interface
 *----------------------------------------------------------*/
#include "dlcvcam-rk3576-csi0.dtsi"
// #include "dlcvcam-rk3576-csi1.dtsi"
// #include "dlcvcam-rk3576-csi3.dtsi"

/*-----------------------------------------------------------
 * MINI-PCIe Configuration
 *
 * The MINI-PCIe slot supports three mutually exclusive modes.
 *
 * Uncomment exactly one #include below, then recompile the kernel.
 * This is the recommended approach for production images.
 *
 * WARNING: Do NOT use both methods for the same mode simultaneously.
 *   If a #include is active AND its corresponding overlay is loaded,
 *   regulator/device nodes will be duplicated and the kernel will
 *   fail to boot correctly.
 * Hardware cut: MINI-PCIe slot and related SATA/PCIe/4G mode circuits are removed.
 *----------------------------------------------------------*/
// #include "dlcvcam-rk3576-pcie.dtsi"
// #include "dlcvcam-rk3576-sata.dtsi"
// #include "dlcvcam-rk3576-ec20-4g.dtsi"

/* MINI-PCIe/SATA shared Combo PHY0 is disabled after slot removal. */
&combphy0_ps {
	status = "disabled";
};

/*-----------------------------------------------------------
 * Headphone Interface and Onboard Microphone Configuration
 * Hardware cut: ES8388, onboard MIC, headphone jack, headset detect/button circuits are removed.
 *----------------------------------------------------------*/
// #include "dlcvcam-rk3576-headset-onboard-mic.dtsi"

/*-----------------------------------------------------------
 * Display Interface Configuration (HDMI & DP & MIPI)
 * HDMI  : dlcvcam-rk3576-hdmi.dtsi
 * DP    : dlcvcam-rk3576-dp.dtsi
 * MIPI  : Choose different dtsi files according to different screens
 *
 * general file configuration exists for compatibility with device tree overlay mechanism
 * [Special Note]: RK3576 has limited vp path resources
 * Default configuration: HDMI is set to vp0, DP is set to vp1, MIPI-DSI is set to vp2
 * Hardware cut: HDMI_TX connector and related circuits are removed, keep HDMI disabled.
 * Hardware cut: MIPI DSI connector and SY7201ABC related circuits are removed, keep DSI disabled.
 *----------------------------------------------------------*/
// #include "dlcvcam-rk3576-hdmi.dtsi"
#include "dlcvcam-rk3576-dp.dtsi"
// #include "dlcvcam-rk3576-dsi-general.dtsi"

/*
 * Product Model: LCKFB-TSPI-10.1inch-MIPI-TP
 * Screen Name: LCSC-boards LCKFB-TSPI-10.1inch-MIPI-TP
 * Screen Resolution: 800x1280
 * LCSC Part Number: C41409463
 */
// #include "dlcvcam-rk3576-dsi-c41409463.dtsi"

/*
 * Product Model: LCKFB-mipi-3.1inch-screen
 * Screen Name: LCSC-boards LCKFB-mipi-3.1inch-screen
 * Screen Resolution: 480x800
 * LCSC Part Number: C42388916
 */
// #include "dlcvcam-rk3576-dsi-c42388916.dtsi"

&dp0_sound {
	status = "disabled";
};

&spdif_tx3 {
	status = "disabled";
};

/*-----------------------------------------------------------
 * Board Basic Information Configuration
 *----------------------------------------------------------*/
/ {
	model = "DLCV DLCVCAM RK3576 Board";
	compatible = "dlcv,dlcvcam-rk3576", "rockchip,rk3576";

	/*
	 * User LED
	 * Used to indicate system status
	 */
	leds: leds {
		status = "okay";
		compatible = "gpio-leds";

		work_led: work {
			linux,default-trigger = "heartbeat";
			gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * Board Cooling Fan Configuration
	 *
	 * Preset profiles: silent / normal / turbo, plus target-temperature
	 * curves (30/35/40/45/50/55/60 °C full-speed).
	 * Target-temperature curves use 10% speed steps below 90% and 1%
	 * speed steps from 90% to 100% for finer thermal control near full speed.
	 * Profile switching via sysfs; CamOS can fall back to manual_mode=1 + pwm1.
	 */
	fan: pwm-fan {
		status = "okay";
		compatible = "pwm-fan";

		#cooling-cells = <2>;

		pwms = <&pwm2_8ch_3 0 500000 0>;

		/* Fallback cooling levels: 0%,10%,20%,...,100% for user curve */
		cooling-levels = <0 25 51 76 102 128 153 178 204 229 255>;
		rockchip,temp-trips = <
			0        1
			50000    4
			60000    6
			70000    8
			75000    10
		>;

		/* Silent: 50°C 10% -> 75°C 100% */
		rockchip,cooling-levels-silent = <26 26 51 77 102 128 179 255>;
		rockchip,temp-trips-silent = <
			50000    1
			55000    2
			60000    3
			65000    4
			70000    5
			72000    6
			75000    7
		>;

		/* Normal: 45°C 10% -> 70°C 100% */
		rockchip,cooling-levels-normal = <26 26 77 128 179 217 255>;
		rockchip,temp-trips-normal = <
			45000    1
			50000    2
			55000    3
			60000    4
			65000    5
			70000    6
		>;

		/* Turbo: 40°C 10% -> 60°C 100% */
		rockchip,cooling-levels-turbo = <26 26 77 128 191 255>;
		rockchip,temp-trips-turbo = <
			40000    1
			45000    2
			50000    3
			55000    4
			60000    5
		>;

		/* 30 °C 满速曲线：0% -> 100%，90% 以下 10% 跳变，90%-100% 1% 打点 */
		rockchip,cooling-levels-30 = <0 26 51 76 102 128 153 178 204 230 232 235 237 240 242 245 247 250 252 255>;
		rockchip,temp-trips-30 = <11900 1 15800 2 18500 3 20800 4 22700 5 24500 6 26000 7 27400 8 28800 9 28900 10 29000 11 29100 12 29300 13 29400 14 29500 15 29600 16 29800 17 29900 18 30000 19>;

		/* 35 °C 满速曲线：0% -> 100%，90% 以下 10% 跳变，90%-100% 1% 打点 */
		rockchip,cooling-levels-35 = <0 26 51 76 102 128 153 178 204 230 232 235 237 240 242 245 247 250 252 255>;
		rockchip,temp-trips-35 = <13900 1 18400 2 21600 3 24300 4 26500 5 28500 6 30300 7 32000 8 33600 9 33700 10 33900 11 34000 12 34100 13 34300 14 34400 15 34600 16 34700 17 34900 18 35000 19>;

		/* 40 °C 满速曲线：0% -> 100%，90% 以下 10% 跳变，90%-100% 1% 打点 */
		rockchip,cooling-levels-40 = <0 26 51 76 102 128 153 178 204 230 232 235 237 240 242 245 247 250 252 255>;
		rockchip,temp-trips-40 = <15900 1 21000 2 24700 3 27700 4 30300 5 32600 6 34700 7 36600 8 38300 9 38500 10 38700 11 38900 12 39000 13 39200 14 39400 15 39500 16 39700 17 39800 18 40000 19>;

		/* 45 °C 满速曲线：0% -> 100%，90% 以下 10% 跳变，90%-100% 1% 打点 */
		rockchip,cooling-levels-45 = <0 26 51 76 102 128 153 178 204 230 232 235 237 240 242 245 247 250 252 255>;
		rockchip,temp-trips-45 = <17900 1 23600 2 27800 3 31200 4 34100 5 36700 6 39000 7 41200 8 43100 9 43300 10 43500 11 43700 12 43900 13 44100 14 44300 15 44500 16 44600 17 44800 18 45000 19>;

		/* 50 °C 满速曲线：0% -> 100%，90% 以下 10% 跳变，90%-100% 1% 打点 */
		rockchip,cooling-levels-50 = <0 26 51 76 102 128 153 178 204 230 232 235 237 240 242 245 247 250 252 255>;
		rockchip,temp-trips-50 = <19900 1 26300 2 30900 3 34700 4 37900 5 40800 6 43400 7 45700 8 47900 9 48100 10 48400 11 48600 12 48800 13 49000 14 49200 15 49400 16 49600 17 49800 18 50000 19>;

		/* 55 °C 满速曲线：0% -> 100%，90% 以下 10% 跳变，90%-100% 1% 打点 */
		rockchip,cooling-levels-55 = <0 26 51 76 102 128 153 178 204 230 232 235 237 240 242 245 247 250 252 255>;
		rockchip,temp-trips-55 = <21900 1 28900 2 34000 3 38100 4 41700 5 44800 6 47700 7 50300 8 52700 9 53000 10 53200 11 53400 12 53700 13 53900 14 54100 15 54300 16 54600 17 54800 18 55000 19>;

		/* 60 °C 满速曲线：0% -> 100%，90% 以下 10% 跳变，90%-100% 1% 打点 */
		rockchip,cooling-levels-60 = <0 26 51 76 102 128 153 178 204 230 232 235 237 240 242 245 247 250 252 255>;
		rockchip,temp-trips-60 = <23900 1 31500 2 37100 3 41600 4 45500 5 48900 6 52000 7 54900 8 57500 9 57800 10 58000 11 58300 12 58500 13 58800 14 59000 15 59300 16 59500 17 59800 18 60000 19>;
	};

	/*
	 * External Trigger Device
	 * GPIO0_D2 input -> trigger-dev -> imx334 sysfs trigger
	 * -> PWM output on GPIO0_B5
	 */
	trigger_dev: trigger-dev {
		compatible = "embedfire,trigger-dev";
		status = "okay";

		/* GPIO0_D2: external pulse input, active-low (high idle, falling edge) */
		input-gpios = <&gpio0 RK_PD2 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD2 IRQ_TYPE_EDGE_BOTH>;

		pinctrl-names = "default";
		pinctrl-0 = <&trigger_dev_pin &trigger_dev_result_led_pin>;

		/* Input mode: edge for clean external pulses */
		trigger-input-mode = "edge";
		debounce-ms = <10>;
		linux,code = <KEY_CAMERA>;

		/* Result LEDs */
		ok-led-gpios = <&gpio2 RK_PB0 GPIO_ACTIVE_HIGH>;
		ng-led-gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_HIGH>;

		/* Trigger imx334 via sysfs */
		trigger-path = "/sys/bus/i2c/devices/4-001a/trigger";
		trigger-value = "1";
	};
};

/*-----------------------------------------------------------
 * pwm fan channel setting
 *-----------------------------------------------------------*/
&pwm2_8ch_3 {
	status = "okay";
	pinctrl-0 = <&pwm2m3_ch3>;
};

/*-----------------------------------------------------------
 * Board sleep settings
 *-----------------------------------------------------------*/
&rockchip_suspend {
	status = "okay";

	/*
	 *	Sleep log debug enable
	 *	0: Disable
	 *	1: Enable
	 */
	rockchip,sleep-debug-en = <1>;

	/*
	 *	IO retention configuration
	 *
	 *	In sleep scenarios where vdd_logic is powered off
	 *	Maintain the level of RKPM_VCCIO3_RET_EN IO.
	 */
	rockchip,sleep-io-ret-config = <
		(0
		| RKPM_VCCIO3_RET_EN
		)
	>;

	rockchip,regulator-on-before-mem = <&vdd_npu_s0>;
};

/*-----------------------------------------------------------
 * Trigger device pin configuration
 *-----------------------------------------------------------*/
&pinctrl {
	trigger_dev {
		trigger_dev_pin: trigger-dev-pin {
			/* GPIO0_D2: high idle, pull-up, falling edge active */
			rockchip,pins = <0 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		trigger_dev_result_led_pin: trigger-dev-result-led-pin {
			/* GPIO2_B0: OK LED, GPIO2_A7: NG LED */
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	imx334_light_source {
		imx334_light_source_pin: imx334-light-source-pin {
			/* GPIO0_C7: low active, idle high, pull-up */
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		imx334_light_source_active_high_pin: imx334-light-source-active-high-pin {
			/* GPIO0_C7: high active, idle low, pull-down */
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};
