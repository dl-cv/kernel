/*-----------------------------------------------------------
 * Camera Power Enable
 *----------------------------------------------------------*/
&vcc_1v2_mipi_csi {
	status = "okay";
};

&vcc_1v8_mipi_csi {
    status = "okay";
};

&vcc_2v8_mipi_csi {
    status = "okay";
};

/*-----------------------------------------------------------
 * Camera Link Configuration
 *----------------------------------------------------------*/
&i2c4 {
	status = "okay";
	pinctrl-0 = <&i2c4m3_xfer>;

	imx296_mipi0: imx296@1a {
		status = "okay";
		compatible = "sony,imx296lq";
		reg = <0x1a>;
		/* Module has on-board 37.125MHz oscillator, disable board MCLK */
		/* clocks = <&cru CLK_MIPI_CAMERAOUT_M0>; */
		/* assigned-clocks = <&cru CLK_MIPI_CAMERAOUT_M0>; */
		/* assigned-clock-rates = <74250000>; */
		/* clock-names = "inck"; */
		/* pinctrl-names = "default"; */
		/* pinctrl-0 = <&cam_clk0m0_clk0>; */
		power-domains = <&power RK3576_PD_VI>;

		avdd-supply = <&vcc_mipicsi0_avdd>;
		dvdd-supply = <&vcc_mipicsi0_dvdd>;
		ovdd-supply = <&vcc_mipicsi0_dovdd>;

		reset-gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;

		/* Kernel light source control on OUTPUT1 only */
		light-source-gpios = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
		light-source-active-level = "high";
		light-source-exposure-offset-us = <0>;

		/* External trigger: PWM output on GPIO0_B5 (pwm1_ch1_m0) */
		pwm-names = "trigger";
		pwms = <&pwm1_6ch_1 0 10000000 PWM_POLARITY_INVERTED>;
		rockchip,trigger-pulse-us = <800>;

		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "IMX296-MIPI";
		rockchip,camera-module-lens-name = "default";

		/* 0 = FREE_RUN, 1 = XTRIG_ONE_SHOT */
		trigger-mode = <1>;

		port {
			imx296_dcphy0_out: endpoint {
				remote-endpoint = <&dcphy0_in_imx296>;
				clock-lanes = <0>;
				data-lanes = <1>;
			};
		};
	};
};


&csi2_dcphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			dcphy0_in_imx296: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&imx296_dcphy0_out>;
				data-lanes = <1>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidcphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi0_csi2_input>;
			};
		};
	};
};


&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidcphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi0_in0>;
			};
		};
	};
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi0_in0: endpoint {
			remote-endpoint = <&mipi0_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};


/*-----------------------------------------------------------
 * MIPI-CSI-0 Link Virtual Interface Enable
 *----------------------------------------------------------*/
&rkisp_vir0_sditf {
	status = "okay";
};

&rkvpss_vir0 {
	status = "okay";
};


/*-----------------------------------------------------------
 * General Configuration
 *----------------------------------------------------------*/
&rkcif {
	status = "okay";
};

&rkcif_mmu {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkvpss {
	status = "okay";
};

&rkvpss_mmu {
	status = "okay";
};

/*-----------------------------------------------------------
 * PWM1 CH1 for IMX296 external trigger output on GPIO0_B5
 *----------------------------------------------------------*/
&pwm1_6ch_1 {
	status = "okay";
};
