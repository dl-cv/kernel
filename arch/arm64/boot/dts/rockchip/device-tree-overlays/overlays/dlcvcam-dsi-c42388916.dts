/dts-v1/;
/plugin/;

#include <dt-bindings/usb/pd.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/display/drm_mipi_dsi.h>
#include <dt-bindings/display/rockchip_vop.h>
#include <dt-bindings/sensor-dev.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
/*-----------------------------------------------------------
 * PWM controller node
 * pwm2_8ch_2: Multi-channel PWM, backlight control
 * status: enable
 * pinctrl-0: Bind PWM output pins
 *-----------------------------------------------------------*/
	fragment@0 {
		target = <&pwm2_8ch_2>;
		
		__overlay__ {
			status = "okay";
			pinctrl-0 = <&pwm2m3_ch2>;
		};
	};

/*-----------------------------------------------------------
 * MIPI DSI display interface main node
 *-----------------------------------------------------------*/
	fragment@1 {
		target = <&dsi>;
		
		__overlay__ {

			status = "okay";
			// rockchip,lane-rate = <500>;
			dsi_panel: panel@0 {
				status = "okay";
				compatible = "simple-panel-dsi";
				reg = <0>;
				backlight = <&backlight>;
				// power-supply = <&mipi_dsi_power>;
				reset-gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_LOW>;
				bpc = <8>;

				reset-delay-ms = <200>;
				enable-delay-ms = <100>;
				prepare-delay-ms = <20>;
				unprepare-delay-ms = <20>;
				disable-delay-ms = <20>;
				init-delay-ms = <120>;

				dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
					MIPI_DSI_MODE_LPM  )>;
				dsi,format = <MIPI_DSI_FMT_RGB888>;
				dsi,lanes  = <2>;

				panel-init-sequence = [
					// init code
					05 78 01 01
					05 78 01 11
					39 0A 06 FF 77 01 00 00 11
					15 0A 02 D1 11
					15 0A 02 55 B0 // 80 90 b0
					39 0A 06 FF 77 01 00 00 10
					39 0A 03 C0 63 00
					39 0A 03 C1 09 02
					39 0A 03 C2 37 08
					15 0A 02 C7 00 // x-dir rotate 0:0x00,rotate 180:0x04
					15 0A 02 CC 38
					39 0A 11 B0 00 11 19 0C 10 06 07 0A 09 22 04 10 0E 28 30 1C
					39 6E 11 B1 00 12 19 0D 10 04 06 07 08 23 04 12 11 28 30 1C
					39 0A 06 FF 77 01 00 00 11 // enable  bk fun of  command 2  BK1
					15 0A 02 B0 4D
					15 0A 02 B1 60 // 0x56  0x4a  0x5b
					15 0A 02 B2 07
					15 6E 02 B3 80
					15 0A 02 B5 47
					15 0A 02 B7 8A
					15 0A 02 B8 21
					15 0A 02 C1 78
					15 0A 02 C2 78
					15 0A 02 D0 88
					39 0A 04 E0 00 00 02
					39 0A 0C E1 01 A0 03 A0 02 A0 04 A0 00 44 44
					39 0A 0D E2 00 00 00 00 00 00 00 00 00 00 00 00
					39 0A 05 E3 00 00 33 33
					39 0A 03 E4 44 44
					39 0A 11 E5 01 26 A0 A0 03 28 A0 A0 05 2A A0 A0 07 2C A0 A0
					39 0A 05 E6 00 00 33 33
					39 0A 03 E7 44 44
					39 0A 11 E8 02 26 A0 A0 04 28 A0 A0 06 2A A0 A0 08 2C A0 A0
					39 0A 08 EB 00 01 E4 E4 44 00 40
					39 0A 11 ED FF F7 65 4F 0B A1 CF FF FF FC 1A B0 F4 56 7F FF
					15 0A 02 EE 42 // missing?
					39 0A 06 FF 77 01 00 00 00
					15 0A 02 36 00 //U&D  Y-DIR rotate 0:0x00,rotate 180:0x10
					15 0A 02 3A 55
					05 78 01 11           
					05 14 01 29		
				];

				panel-exit-sequence = [
					05 00 01 28
					05 00 01 10
				];

				disp_timings0: display-timings {
					native-mode = <&dsi_timing0>;
					dsi_timing0: timing0 {

						clock-frequency = <30816000>; // (480+50+60+10)*(800+20+34+2)*60

						hactive = <480>;
						hfront-porch = <50>;
						hback-porch = <60>;
						hsync-len = <10>;

						vactive = <800>;
						vfront-porch = <20>;
						vback-porch = <34>;
						vsync-len = <2>;

						hsync-active = <0>;
						vsync-active = <0>;
						de-active = <0>;
						pixelclk-active = <0>;

						swap-rb = <0>;
						swap-rg = <0>;
						swap-gb = <0>;
					};
				};

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						panel_in_dsi: endpoint {
							remote-endpoint = <&dsi_out_panel>;
						};
					};
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					dsi_out_panel: endpoint {
						remote-endpoint = <&panel_in_dsi>;
					};
				};
			};
		};
	};

/*-----------------------------------------------------------
 * DSI display routing node
 * route_dsi: Display video channel routing, VP2 output connected to DSI
 *-----------------------------------------------------------*/
	fragment@2 {
		target = <&route_dsi>;
		
		__overlay__ {
			status = "okay";
			connect = <&vp2_out_dsi>;
		};
	};

/*-----------------------------------------------------------
 * DSI display channel configuration description
 * dsi_in_vp0: Supports up to 4K@120Hz (main channel)
 * dsi_in_vp1: Supports up to 2560x1600@60Hz (secondary channel)
 * dsi_in_vp2: Supports up to 1920x1080@60Hz (third channel)
 * Enable the required channel based on actual needs to save resources
 * dsi_in_vopl: VOPL Lite video pipeline, for special purposes
 *-----------------------------------------------------------*/
	fragment@3 {
		target = <&dsi_in_vp0>;
		__overlay__ {
			status = "disabled";
		};
	};
	fragment@4 {
		target = <&dsi_in_vp1>;
		__overlay__ {
			status = "disabled";
		};
	};
	fragment@5 {
		target = <&dsi_in_vp2>;
		__overlay__ {
			status = "okay";
		};
	};
	fragment@6 {
		target = <&dsi_in_vopl>;
		__overlay__ {
			status = "disabled"; // Disable third display channel
		};
	};

/*-----------------------------------------------------------
 * VP2 video channel node
 * status: Enable VP2 as the video source for DSI
 *-----------------------------------------------------------*/
	fragment@7 {
		target = <&vp2>;
		__overlay__ {
			status = "okay";
		};
	};

/*-----------------------------------------------------------
 * Touch node
 *-----------------------------------------------------------*/
	fragment@8 {
		target = <&i2c0>;
		__overlay__ {

			pinctrl-names = "default";
			pinctrl-0 = <&i2c0m1_xfer>;
			clock-frequency = <400000>;
			status = "okay";

			cst128@38 {
				compatible = "cst128,touch";
				reg = <0x38>;
				tp-size = <89>;
				max-x = <480>;
				max-y = <800>;
				touch-gpio = <&gpio0 RK_PC5 IRQ_TYPE_LEVEL_LOW>;
				reset-gpio = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
			};
		};
	};
};




